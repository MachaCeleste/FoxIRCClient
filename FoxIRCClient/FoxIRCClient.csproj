<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Fox.ico</ApplicationIcon>
    <Title>Fox IRC Client</Title>
    <Version>1.0.0</Version>
    <Authors>Macha Celeste</Authors>
    <Company>Celestial Corp</Company>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Page Remove="ExampleTheme.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fox.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ExampleTheme.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FoxIrc">
      <HintPath>..\..\FoxIrc\FoxIrc\bin\Release\net9.0\FoxIrc.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
