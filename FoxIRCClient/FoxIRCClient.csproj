<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Fox.ico</ApplicationIcon>
    <Title>Fox IRC Client</Title>
    <Version>0.1.0</Version>
    <Authors>Macha Celeste</Authors>
    <Company>Celestial Corp</Company>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Fox.ico" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FoxIrc">
      <HintPath>..\..\FoxIrc\FoxIrc\bin\Release\net9.0\FoxIrc.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Themes\" />
  </ItemGroup>

</Project>
